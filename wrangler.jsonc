// Konfigurasi Cloudflare Workers Static Assets. Situs ini statis sepenuhnya:
// tidak ada skrip Worker, hanya berkas di dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devmecum",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
