{
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm preview *)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm validate)",
      "Bash(pnpm validate *)",
      "Bash(pnpm new-tech *)",
      "Bash(pnpm versions *)",
      "Bash(pnpm metrics)",
      "Bash(pnpm budget)",
      "Bash(pnpm lhci)",
      "Bash(pnpm vitest *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(pnpm dev)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm preview *)",
      "PowerShell(pnpm check)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm test:e2e)",
      "PowerShell(pnpm validate)",
      "PowerShell(pnpm validate *)",
      "PowerShell(pnpm new-tech *)",
      "PowerShell(pnpm versions *)",
      "PowerShell(pnpm metrics)",
      "PowerShell(pnpm budget)",
      "PowerShell(pnpm lhci)",
      "PowerShell(pnpm vitest *)",
      "PowerShell(node scripts/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/protect-files.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/validate-edited.mjs"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/validate-on-stop.mjs"]
          }
        ]
      }
    ]
  }
}
