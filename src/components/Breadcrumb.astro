---
// Remah roti: Beranda › domain › teknologi › bab. Setiap ruas yang punya
// `href` menjadi tautan; ruas terakhir menandai halaman aktif.
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="dm-breadcrumb" aria-label="Remah roti">
  <ol>
    {
      items.map((item, index) => (
        <li aria-current={index === items.length - 1 ? 'page' : undefined}>
          {item.href ? <a href={item.href}>{item.label}</a> : item.label}
        </li>
      ))
    }
  </ol>
</nav>
